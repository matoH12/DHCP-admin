# DHCP Admin - Environment Variables Example
# Copy this file to .env and customize for your deployment

# Admin User Credentials
# IMPORTANT: Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminDHCP2026!
ADMIN_EMAIL=admin@example.com

# Security
# Generate a random secret key for production: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:80

# Database
DATABASE_URL=sqlite:///./data/dhcp-admin.db

# DHCP Configuration
DHCP_CONFIG_PATH=/dhcp-config/dhcpd.conf

# Docker Network (automatically detected and created in database on first run)
# The backend auto-detects the Docker network subnet from the container's network interface
# This subnet is required for DHCP server to start in Docker
# The network range is created as "Docker Bridge Network" in the database
# You can override auto-detection by setting this variable (optional):
# DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Application
APP_NAME=DHCP Admin
DEBUG=false
