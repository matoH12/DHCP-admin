# DHCP Admin Panel - Environment Configuration
# Copy this file to .env and update the values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=DHCP Admin
DEBUG=false

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=sqlite:///./data/dhcp-admin.db

# ==============================================================================
# SECURITY
# ==============================================================================
# IMPORTANT: Generate a strong random secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-characters-long

# JWT token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated list of allowed origins
# For production, set to your specific domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:80

# ==============================================================================
# SECURITY FEATURES (Optional - Production Recommended)
# ==============================================================================
# Enable/disable individual security features
# Set to 'false' if deploying behind a trusted reverse proxy that handles security

# Enable CORS middleware
ENABLE_CORS=true

# Enable rate limiting (protects against brute force attacks)
ENABLE_RATE_LIMITING=true

# Enable security headers (HSTS, CSP, X-Frame-Options, etc.)
ENABLE_SECURITY_HEADERS=true

# ==============================================================================
# DHCP CONFIGURATION
# ==============================================================================
# Path where the DHCP configuration file will be generated
# This should be mounted to your DHCP server's config directory
DHCP_CONFIG_PATH=/dhcp-config/dhcpd.conf

# Production example (mount to actual DHCP server directory):
# DHCP_CONFIG_PATH=/etc/dhcp/dhcpd.conf

# ==============================================================================
# ADMIN USER
# ==============================================================================
# These credentials will be used to create the initial admin user
# IMPORTANT: Change these before deploying to production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password
ADMIN_EMAIL=admin@yourdomain.com

# ==============================================================================
# SYSLOG SETTINGS (Optional)
# ==============================================================================
# Automatic cleanup of old syslog messages (in days)
SYSLOG_RETENTION_DAYS=180

# ==============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ==============================================================================
# For production deployment with full security:
#
# 1. Generate secure SECRET_KEY:
#    openssl rand -hex 32
#
# 2. Change ADMIN_PASSWORD to a strong password
#
# 3. Set CORS_ORIGINS to your specific domain(s):
#    CORS_ORIGINS=https://dhcp.yourdomain.com
#
# 4. Enable all security features:
#    ENABLE_CORS=true
#    ENABLE_RATE_LIMITING=true
#    ENABLE_SECURITY_HEADERS=true
#
# 5. Set DEBUG=false
#
# 6. Use HTTPS (see DEPLOYMENT.md for SSL setup options):
#    - Let's Encrypt (free, auto-renewing)
#    - Self-signed (for internal networks)
#    - Custom certificate
#    - HTTP-only behind HTTPS proxy
#
# For detailed deployment instructions, see:
# - DEPLOYMENT.md - Full production deployment guide
# - FLEXIBLE-DEPLOYMENT.md - Multiple deployment scenarios
# - SECURITY.md - Security best practices
